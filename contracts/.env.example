# Monad deployment foundation
# Copy this file to .env locally and fill in real values.
# Do not commit secrets.

# Deployer wallet private key for forge broadcast
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Cleanverse / Monad addresses required by current contract constructors
CLEANVERSE_CVI_ADDRESS=0x0000000000000000000000000000000000000000
CLEANVERSE_CVA_ADDRESS=0x0000000000000000000000000000000000000000
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
VALIDATOR_POOL_OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Monad network
MONAD_RPC_URL=https://rpc.testnet.monad.xyz
CHAIN_NAME=monad
CHAIN_ID=10143
